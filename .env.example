# Token do bot (BotFather no Telegram). Cole você mesmo, nunca envie a ninguém.
TELEGRAM_BOT_TOKEN=
# Seu ID numérico do Telegram. O bot ignora qualquer outra pessoa.
ALLOWED_USER_ID=
# Modelo do Claude Code: sonnet (padrão), haiku (mais leve) ou opus (gasta mais do seu limite)
CLAUDE_MODEL=sonnet
# Ferramentas liberadas (somente leitura + web). Veja o README antes de ampliar.
ALLOWED_TOOLS=Read,Glob,Grep,WebSearch,WebFetch
# Tempo máximo por resposta, em milissegundos
CLAUDE_TIMEOUT_MS=180000

# --- Central de Bots (opcional) ---
# Composio (conta "For You"): URL fixa + sua chave (cole você mesmo; nunca envie a ninguém).
# Chave em: Composio > Settings > Sessions & API Key (começa com ck_). Sem isso, os bots não usam apps conectados.
# COMPOSIO_MCP_URL=https://connect.composio.dev/mcp
# COMPOSIO_API_KEY=
# Tamanho máximo de arquivo enviado ao chat, em MB (padrão 1024)
# UPLOAD_MAX_MB=1024
# Limite diário de chamadas ao Claude (também editável na interface)
# DAILY_CALL_CAP=40
